{
  "manifest_version": 3,
  "name": "CyberShield: Phishing Detection",
  "version": "2.0",
  "description": "AI-Based Real-Time Phishing Detection Browser Extension",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CyberShield"
  },
  "background": {
    "service_worker": "background/background.js"
  }
}
